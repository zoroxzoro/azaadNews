# Azaad Samachar (आज़ाद समाचार) - Environment Configuration
# Copy this file to .env or .env.local and fill in your Supabase project credentials.

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Publishable / Anon Key (Safe for frontend exposure, guarded by RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Backward-compatible alias for standard Supabase anon key
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: REST API Base URL (if using external proxy or backend server)
# VITE_API_BASE_URL=http://localhost:3000/api

# -----------------------------------------------------------------------------
# CRITICAL SECURITY NOTICE:
# DO NOT place SUPABASE_SERVICE_ROLE_KEY or database passwords in this file or any
# client-side code. The service_role key bypasses Row Level Security and must only
# be used in isolated backend Node.js scripts (such as the WordPress migration CLI).
# -----------------------------------------------------------------------------
