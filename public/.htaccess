# ==============================================================================
# Hostinger Premium Shared Hosting Configuration - Azaad Samachar
# Production Domain: https://azaadsamacharindia.com
# Tech: Single Page Application (React + Vite)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enforce HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirect www to non-www canonical domain (azaadsamacharindia.com)
  RewriteCond %{HTTP_HOST} ^www\.azaadsamacharindia\.com$ [NC]
  RewriteRule ^(.*)$ https://azaadsamacharindia.com/$1 [L,R=301]

  # 3. Prevent direct access to sensitive and source files
  RewriteRule ^(\.git|\.env|package\.json|package-lock\.json|vite\.config\.js) - [F,L,NC]

  # 4. Do not rewrite real existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Social Media Crawler Bridge (WhatsApp, Facebook, Twitter, Telegram, LinkedIn, Pinterest, Discord)
  # Direct scrapers to crawler-preview.php so rich Open Graph previews render without JavaScript
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Discordbot|Pinterest|Slackbot) [NC]
  RewriteRule ^(news|article)/([^/]+)/?$ crawler-preview.php?slug=$2 [L,QSA]

  # 6. SPA Fallback: Direct all human visitor routes (/news/*, /category/*, /admin/*) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ==============================================================================
# HTTP Security Headers
# ==============================================================================
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ==============================================================================
# Caching Strategy for Vite Build Artifacts
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Vite hashed assets (JS, CSS, fonts, WebP images) can be cached long-term (1 year)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # HTML documents and XML sitemaps must always revalidate
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # Enforce no-cache on HTML documents so SPA updates are immediately reflected
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Immutable caching for hashed assets in assets/ folder
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff2|woff)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

# ==============================================================================
# Gzip Compression for Fast Loading
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/truetype
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
